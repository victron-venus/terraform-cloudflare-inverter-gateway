# Copy to local.secrets.tfvars (gitignored).
# Auth usually comes from bashrc instead:
#   export TF_VAR_account_xyz=...
#   export TF_VAR_email_xyz=...
#   export TF_VAR_key_xyz=...
# You may still put them here if preferred (do not commit).

# account_xyz = "0123456789abcdef0123456789abcdef"
# email_xyz   = "you@example.com"
# key_xyz     = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

team_name               = "your-team"
gateway_public_hostname = "victron.example.com"
access_app_name         = "victron"
allow_policy_name       = "victron"
allow_emails            = ["you@example.com"]

service_token_name     = "inverter-desktop"
service_token_duration = "forever"

gateway_api_token = "replace-with-GATEWAY_API_TOKEN"

manage_tunnel_config  = false
tunnel_id             = "00000000-0000-0000-0000-000000000000"
tunnel_origin_service = "http://127.0.0.1:9150"
